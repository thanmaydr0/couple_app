{
  "expo": {
    "name": "Us",
    "slug": "us-app",
    "version": "1.1.0",
    "platforms": [
      "android"
    ],
    "scheme": "us",
    "userInterfaceStyle": "dark",
    "orientation": "default",
    "android": {
      "package": "com.thanmay.teser",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EBA5B5",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Us to access the memories you choose to share.",
          "savePhotosPermission": "Allow Us to save your shared memories.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow Us to use your camera for video calls with your partner.",
          "microphonePermission": "Allow Us to use your microphone for calls with your partner."
        }
      ],
      "expo-updates",
      "react-native-compressor",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Us to access photos you choose to share.",
          "cameraPermission": "Allow Us to capture memories with your camera.",
          "microphonePermission": "Allow Us to record audio in your videos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Us to record voice messages.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": true
        }
      ],
      "expo-screen-orientation",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161118",
          "image": "./assets/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-asset",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Us to share your location with your partner only while sharing is switched on.",
          "locationAlwaysAndWhenInUsePermission": "Allow Us to keep optional partner location sharing and place alerts working in the background. You can stop sharing at any time.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Us to use biometrics to unlock private content when you enable the lock."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Us to detect device motion for interactive partner experiences when enabled."
        }
      ],
      [
        "react-native-notify-kit",
        {
          "android": {
            "foregroundService": {
              "types": [
                "location",
                "mediaPlayback",
                "mediaProjection",
                "microphone",
                "camera"
              ]
            }
          }
        }
      ],
      "./plugins/with-incoming-call",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "UsWidget",
              "label": "Us",
              "description": "Days together and partner status",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "PhotoWidget",
              "label": "Photo",
              "description": "Photo of the day",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "DoodleWidget",
              "label": "Doodle",
              "description": "Your partner’s latest doodle",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "HeartbeatWidget",
              "label": "Heartbeat",
              "description": "One-tap heartbeat",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/9ed6b019-a224-484f-9d5c-f5c6e7e3ec11"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ed6b019-a224-484f-9d5c-f5c6e7e3ec11"
      }
    },
    "owner": "thanmaydr",
    "icon": "./assets/icon.png"
  }
}
